{
  "manifest_version": 3,
  "name": "LineTab",
  "version": "1.0.0",
  "description": "只有一条底线的搜索新标签页：零网络请求、零依赖、零构建，搜索走你自己的引擎。",
  "chrome_url_overrides": {
    "newtab": "focus.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
